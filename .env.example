# ==================================================
# APLICACAO
# ==================================================

NODE_ENV=development
PORT=4500
APP_URL=http://localhost:4500
FRONTEND_URL=http://localhost:4500

# ==================================================
# BANCO DE DADOS POSTGRESQL
# ==================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=petflow
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres

# Railway pode usar DATABASE_URL no lugar das variaveis DB_* acima.
DATABASE_URL=
# No Railway use ${{Postgres.PGDATABASE}}. Localmente mantenha petflow.
DB_EXPECTED_NAME=petflow
DB_SSL=false

# ==================================================
# AUTENTICACAO
# ==================================================

JWT_SECRET=troque_por_uma_chave_forte_e_grande
JWT_EXPIRES_IN=7d

# ==================================================
# ADMIN PADRAO PARA SEED
# ==================================================

ADMIN_EMAIL=admin@petflow.com.br
ADMIN_PASSWORD=Admin@123

# ==================================================
# CLOUDINARY
# ==================================================

CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# Limite de upload em bytes. Exemplo: 5 MB.
MAX_FILE_SIZE=5242880

# ==================================================
# RESEND / EMAIL
# ==================================================

RESEND_API_KEY=sua_chave_resend
EMAIL_FROM=PetFlow <suporte@tigertech.dev.br>
EMAIL_TEST_TO=suporte@tigertech.dev.br

# ==================================================
# PAGSEGURO
# ==================================================

# Sandbox:
# PAGSEGURO_BASE_URL=https://sandbox.api.pagseguro.com

# Producao:
# PAGSEGURO_BASE_URL=https://api.pagseguro.com

PAGSEGURO_BASE_URL=https://api.pagseguro.com
PAGSEGURO_TOKEN=seu_token_pagseguro
# Ative somente se a conta PagBank estiver homologada para debito.
PAGSEGURO_ENABLE_DEBIT=false

# ==================================================
# FRETE E GOOGLE MAPS
# ==================================================

# Chave privada do servidor, restrita a Routes API.
GOOGLE_MAPS_API_KEY=

# Chave publica do mapa, restrita ao dominio e Maps JavaScript API.
GOOGLE_MAPS_BROWSER_API_KEY=

# Endereco completo de onde saem as entregas. Defina depois com os dados da loja.
DELIVERY_ORIGIN_ADDRESS=

# Reserva de estoque para pedidos aguardando pagamento.
ORDER_RESERVATION_MINUTES=30

# Distancia minima para cancelamento automatico durante uma entrega, em metros.
CANCELLATION_MIN_DISTANCE_METERS=1000

# ==================================================
# TESTES DE INTEGRACAO
# ==================================================

# Nunca ative apontando para producao.
RUN_DB_TESTS=0

# Frete: definir conforme política comercial real da loja. Não há endereço fixo.
DELIVERY_FREE_DISTANCE_KM=0
DELIVERY_PRICE_PER_KM=
DELIVERY_MAX_DISTANCE_KM=
# true: cobra distância proporcional; false: arredonda km excedente para cima.
DELIVERY_CHARGE_FRACTION=true
PRIVACY_POLICY_VERSION=2026-10-04

# Banco isolado: nome deve começar por petflow_test; não usar produção.
TEST_DATABASE_URL=
TEST_DATABASE_NAME=

# Janela operacional para cancelamento automático (não substitui direitos legais).
CANCELLATION_WINDOW_MINUTES=30
